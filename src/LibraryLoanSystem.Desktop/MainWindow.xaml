<Window x:Class="LibraryLoanSystem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryLoanSystem.Desktop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" 
        WindowStartupLocation="CenterScreen"
        Background="#00496e">
    <Grid>
        <TextBlock HorizontalAlignment="Center"
           VerticalAlignment="Bottom"
           Margin="0,0,0,10"
           FontSize="15"
           FontWeight="Bold"
           TextAlignment="Center">

    <Hyperlink NavigateUri="https://bisliev.it/"
               RequestNavigate="CompanyLink_RequestNavigate"
               TextDecorations="None"
               Foreground="White">
        Bisliev.it
    </Hyperlink>

    <LineBreak/>

    <Hyperlink NavigateUri="https://github.com/547MAN/library-loan-system"
               RequestNavigate="CompanyLink_RequestNavigate"
               TextDecorations="None"
               Foreground="White">
        Github Repo
    </Hyperlink>

        </TextBlock>

        <Grid Width="350"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Enter your Username"
                       Margin="0,0,0,5"
                       Foreground="White"
                       />
            <TextBox Grid.Row="1"
                     Height="35"
                     Margin="0,0,0,15"
                     FontSize="20"/>
            <TextBlock Grid.Row="2"
                       Text="Enter your Password"
                       Margin="0,0,0,5"
                       Foreground="White"
                       />
            <PasswordBox Grid.Row="3"
                         Height="35"
                         Margin="0,0,0,20"
                         FontSize="20"/>
            <Button Grid.Row="4"
                    Width="100"
                    Height="35"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    Foreground="White"
                    Background="#1C5D99"
                    Content="Login"
                    Click="LoginButton_Click"/>
        </Grid>
    </Grid>
</Window>
