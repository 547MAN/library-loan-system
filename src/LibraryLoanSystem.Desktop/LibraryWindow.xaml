<Window x:Class="LibraryLoanSystem.Desktop.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryLoanSystem.Desktop"
        mc:Ignorable="d"
        Title="LibraryWindow" Height="450" Width="800"
        WindowStartupLocation='CenterScreen'>
    <Grid>
        <TextBlock Text="Library"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   FontSize="28" Margin="0,25,0,0"/>
        <Button Content="Logout"
                Width="120"
                Height="35"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20"
                Click="LogoutButton_Click"/>
        <Grid Width="300"
              Height="35"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,100,0,0">

            <TextBox x:Name="SearchTextBox"
                     Padding="5,0,35,0"
                     KeyDown="SearchTextBox_KeyDown"
                     TextChanged="SearchTextBox_TextChanged"/>
                     
            <Button x:Name="ClearSearchButton"
                    Content="X"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,3,0"
                    Background="White"
                    Visibility="Collapsed"
                    Click="ClearSearchButton_Click"/>
        </Grid>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="530,100,0,0">
            <Button Content="Search"
                Width="100"
                Height="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,0,10,0"
                Click="SearchButton_Click"/>
            <Button Content="Add filter"
                    Width="100"
                    Height="35"
                    Click="AddFilterButton_Click"/>
        </StackPanel>
        <StackPanel x:Name="FilterPanel" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,150,0,0"
                    Visibility="Collapsed">
        <ComboBox x:Name="CategoryComboBox"
                  Width="160"
                  Height="30"
                  SelectedIndex="0">
                <ComboBoxItem Content="All Categories"/>
                <ComboBoxItem Content="Dystopian Fiction"/>
                <ComboBoxItem Content="Fiction"/>
                <ComboBoxItem Content="Fantasy"/>
                <ComboBoxItem Content="Science"/>
                <ComboBoxItem Content="Technology"/>
                <ComboBoxItem Content="History"/>
            </ComboBox>
            <Button Content="Apply filter"
                    Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    Click="ApplyFilterButton_Click"/>
        </StackPanel>
        <Border x:Name="ActiveFilterTag" 
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,66,160,0"
                Padding="8,4"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="5"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ActiveFilterTextBlock"
                           Text="Category: Fiction"
                           VerticalAlignment="Center"/>
                <Button Content="X"
                        Width="22"
                        Height="22"
                        Margin="8,0,0,0"
                        Click="RemoveFilterButton_Click"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="SearchResultTextBlock"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,160,0,0"
                   FontSize="16"/>
    </Grid>
</Window>
