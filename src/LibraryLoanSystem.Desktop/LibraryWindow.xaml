<Window x:Class="LibraryLoanSystem.Desktop.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryLoanSystem.Desktop"
        mc:Ignorable="d"
        Title="LibraryWindow" Height="450" Width="800"
        WindowStartupLocation='CenterScreen'>
    <Grid>
        <TextBlock Text="Library"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   FontSize="28" Margin="0,25,0,0"/>
        <Button Content="Logout"
                Width="120"
                Height="35"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20"
                Click="LogoutButton_Click"/>
        <Grid Width="300"
              Height="35"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,100,0,0">

            <TextBox x:Name="SearchTextBox"
                     Padding="5,0,35,0"
                     KeyDown="SearchTextBox_KeyDown"
                     TextChanged="SearchTextBox_TextChanged"/>
                     
            <Button x:Name="ClearSearchButton"
                    Content="X"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,3,0"
                    Background="White"
                    Visibility="Collapsed"
                    Click="ClearSearchButton_Click"/>
        </Grid>

        <Button Content="Search"
                Width="100"
                Height="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="420, 100, 0 ,0"
                Click="SearchButton_Click"/>
       
        <TextBlock x:Name="SearchResultTextBlock"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,160,0,0"
                   FontSize="16"/>
    </Grid>
</Window>
